generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  ONG
  ADMIN
}

model User {
  // nao mexer entre aqui >
  id            String    @id @map("_id") // o id do user deve ser assim por causa do better auth
  name          String
  email         String    @unique
  emailVerified Boolean?
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  role          Role      @default(ONG)
  // < e aqui

  ong Ong?

  @@map("user")
}

// crie modelos novos!

enum OngStatus {
  RASCUNHO // conta criada, cadastro em andamento (passos 3 a 8)
  PUBLICADA // visível no mapa e na lista
  SUSPENSA // retirada do ar pelo admin
}

// endereço como veio da Receita Federal na validação do CNPJ
type EnderecoReceita {
  tipoLogradouro String?
  logradouro     String?
  numero         String?
  complemento    String?
  bairro         String?
  municipio      String?
  uf             String?
  cep            String?
}

// endereço confirmado pela ONG no passo 3
type Endereco {
  logradouro  String // com o tipo (ex.: Rua Domingos de Morais)
  numero      String?
  complemento String?
  bairro      String
  municipio   String
  uf          String
  cep         String // só dígitos
}

// ponto GeoJSON: coordinates = [longitude, latitude] (formato do índice 2dsphere do MongoDB)
type Ponto {
  type        String  @default("Point")
  coordinates Float[]
}

type Contato {
  valor   String
  visivel Boolean @default(true) // desmarcado fica salvo, mas não aparece no perfil
}

// passo 4; a ordem dos campos é a ordem dos botões no perfil
type Contatos {
  whatsapp  Contato? // E.164, ex.: +5511971234567
  email     Contato?
  site      Contato? // URL completa, com https://
  instagram Contato? // @usuario
}

// item fora da lista fixa, digitado pela ONG no passo 5
type ItemLivre {
  nome  String // como a ONG escreveu
  chave String // minúsculas, sem acento: agrupa o mesmo item entre ONGs
}

enum DiaVoluntariado {
  DOMINGO
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
  SABADO
  DIAS_UTEIS
  FIM_DE_SEMANA
  TODO_DIA
}

enum Turno {
  MANHA
  TARDE
  NOITE
}

// passo 6
type HorarioVoluntariado {
  dia            DiaVoluntariado
  inicio         Int? // hora cheia (0 a 23); sem início nem fim = horário livre
  fim            Int? // hora cheia (1 a 24), maior que o início
  atividade      String // slug de OpcaoLista ATIVIDADE, ou "outra"
  atividadeOutra String? // texto quando a atividade é "outra"
  turnos         Turno[] // derivado do horário, para o filtro de voluntariado
}

model Ong {
  id                  String           @id @default(auto()) @map("_id") @db.ObjectId
  cnpj                String           @unique // sem máscara; interno, não aparece no perfil público
  razaoSocial         String
  naturezaJuridica    String // código de 4 dígitos da tabela da Receita (ex.: 3999)
  situacaoCadastral   String // como estava na validação (ex.: ATIVA)
  enderecoReceita     EnderecoReceita?
  // false quando a ONG indicou no passo 1 que o endereço da Receita mudou
  usarEnderecoReceita Boolean          @default(true)
  receitaConsultadaEm DateTime
  status              OngStatus        @default(RASCUNHO)
  // próximo passo do cadastro (1 a 8); a conta nasce no passo 2, então começa no 3
  passoAtual          Int              @default(3)

  // passo 3: localização
  endereco           Endereco?
  localizacao        Ponto?
  mostrarSoBairro    Boolean   @default(false) // o perfil mostra só o bairro e um pin aproximado
  // a posição que a área pública vê e consulta: a real, ou um ponto deslocado ao acaso
  // (150 a 400 m) quando mostrarSoBairro. O desvio é sorteado ao salvar e guardado, para não
  // dar para recalcular a posição real a partir de dados públicos.
  localizacaoPublica Ponto?

  // passo 4: contatos e redes
  contatos Contatos?

  // passo 5: causas e itens (slugs de OpcaoLista)
  causas      String[] // 1 a 3
  itens       String[]
  itensLivres ItemLivre[]

  // passo 6: voluntariado
  aceitaVoluntarios      Boolean               @default(false)
  horariosVoluntariado   HorarioVoluntariado[]
  requisitosVoluntariado String?

  // passo 7: apresentação
  nomePublico    String?
  descricaoCurta String? // até 160 caracteres; aparece no card
  sobre          String?
  logo           String? // chave do arquivo no R2
  capa           String? // chave do arquivo no R2

  // passo 8: publicação
  termosAceitosEm DateTime?
  publicadaEm     DateTime?
  // endereço da página pública (/ong/<slug>), criado ao publicar; não muda quando o nome muda.
  // Sem @unique: o índice único do MongoDB não aceitaria vários rascunhos sem slug.
  slug            String?

  // painel: itens marcados como urgentes (O3)
  urgencias Urgencia[]

  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@map("ong")
}

// item marcado como urgente no painel; o selo sai sozinho depois de `ate`
type Urgencia {
  item     String // slug do item da lista fixa, ou "livre:<chave>" para item livre
  nome     String // nome do item quando foi marcado
  detalhe  String? // até 120 caracteres
  criadaEm DateTime
  ate      DateTime
}

enum TipoLista {
  CAUSA
  ITEM
  ATIVIDADE // atividades de voluntariado
}

// opções das listas fixas usadas no cadastro e nos filtros; o admin vai gerenciá-las
// (preenchidas por prisma/seed.ts)
model OpcaoLista {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  tipo      TipoLista
  slug      String // chave estável, gravada na Ong; não muda quando o nome muda
  nome      String
  ordem     Int       @default(0)
  ativa     Boolean   @default(true) // inativa some do cadastro, mas continua valendo para quem já usa
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([tipo, slug])
  @@map("opcao_lista")
}

// evitar mexer daqui pra baixo
// nesses 3 modelos do better auth
model Session {
  id        String   @id @map("_id")
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id @map("_id")
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id @map("_id")
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}
