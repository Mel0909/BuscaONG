DATABASE_URL= # url do mongodb + /nome-da-db

# e-mail (Resend). Em desenvolvimento pode ficar vazio: os e-mails aparecem no terminal.
# Em produção, EMAIL_FROM precisa ser de um domínio verificado no Resend.
RESEND_API_KEY= # re_... (painel do Resend)
EMAIL_FROM="BuscaONG <nao-responda@seu-dominio.org.br>"

# mapa (Mapbox GL JS). Token público (pk.…), restrito por URL no painel do Mapbox.
# Sem ele, o passo 3 do cadastro mostra "Mapa indisponível".
NEXT_PUBLIC_MAPBOX_TOKEN=

# imagens das ONGs (Cloudflare R2, API compatível com S3). Sem elas, o envio de imagens fica desligado.
# O bucket precisa de CORS liberando PUT a partir do site (e de http://localhost:3000 em dev).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL= # domínio público do bucket, ex.: https://imagens.seu-dominio.org.br

BETTER_AUTH_URL="http://localhost:3000" # IMPORTANTE MANTER CERTO se usa rotas como a de forgot password
BETTER_AUTH_SECRET= # gerar usando o comando: openssl rand -base64 32

# revalidação diária do CNPJ (rotina da Vercel em vercel.json). A Vercel manda este valor no
# header Authorization; sem ele, a rota /api/cron/revalidacao-cnpj recusa tudo.
CRON_SECRET= # gerar com: openssl rand -hex 32
