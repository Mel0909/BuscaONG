# Antes de cada push (docs/git.md §7): nada direto na main e, se a branch mexe no app (web/),
# o lint sem erros. Build e e2e são lentos e ficam para antes de abrir o PR (docs/git.md §6).

# o git manda uma linha por ref enviada: <ref local> <sha local> <ref remota> <sha remoto>
while read -r _ _ ref_remota _; do
  if [ "$ref_remota" = "refs/heads/main" ]; then
    echo "Push direto na main não é permitido. Envie a branch e abra um PR."
    exit 1
  fi
done

# o que a branch muda desde que saiu da main; sem a main remota, confere tudo
base=$(git merge-base HEAD origin/main 2>/dev/null)
if [ -z "$base" ] || git diff --name-only "$base" HEAD | grep -q "^web/"; then
  echo "A branch mexe em web/: conferindo o lint (pnpm --filter web lint:check)"
  pnpm --filter web lint:check || exit 1
fi
