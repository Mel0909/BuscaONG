# Antes de cada commit (docs/git.md §7): nada direto na main, nome de branch no padrão e,
# se o commit mexe no app (web/), os testes do Vitest passando.

# vazio com o HEAD destacado (rebase, bisect): aí não há branch para conferir
branch=$(git symbolic-ref --short -q HEAD)

if [ "$branch" = "main" ]; then
  echo "Commit direto na main não é permitido. Crie uma branch: git switch -c <tipo>/<descricao>"
  exit 1
fi

if [ -n "$branch" ]; then
  sh .husky/validar-branch.sh "$branch" || exit 1
fi

if git diff --cached --name-only | grep -q "^web/"; then
  echo "O commit mexe em web/: rodando os testes (pnpm --filter web test)"
  pnpm --filter web test || exit 1
fi
