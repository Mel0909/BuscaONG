meta {
  name: login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/sign-in/email
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{senha}}"
  }
}

script:post-response {
  // guarda "nome=valor" do cookie de sessão (better-auth.session_token, ou __Secure-... em https)
  const cookies = [].concat(res.headers["set-cookie"] || []);
  const sessao = cookies.map((c) => c.split(";")[0]).find((c) => c.includes("better-auth.session_token="));
  if (sessao) {
    bru.setVar("cookieSessao", sessao);
  } else {
    console.log("Login sem cookie de sessão: confira e-mail, senha e se o e-mail já foi confirmado.");
  }
}

docs {
  Login de ONG ou admin (better-auth). Usa email e senha do ambiente.
  Sucesso: 200 e o cookie de sessão, que a coleção passa a mandar (ver collection.bru).
  E-mail ou senha errados: 401. E-mail de ONG ainda não confirmado: 403.
}
